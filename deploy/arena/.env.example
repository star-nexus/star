# Copy to .env and fill these values. Do not commit .env.
ARENA_DOMAIN=arena.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Copy exact OAuth redirect URLs from the ChatGPT app setup (comma-separated).
CHATGPT_REDIRECT_URIS=
# Opaque Keycloak subject IDs from get_profile; empty means no one can compete.
ARENA_ALLOWED_SUBJECTS=
ARENA_BOSS_SUBJECTS=
ARENA_OPEN_REGISTRATION=0
ARENA_SEASON=s1
